{
  "version": "1.1.0",
  "organization": "The Flat Rate Movers",
  "organization_url": "https://theflatratemovers.com",
  "developer_portal": "https://theflatratemovers.com/developer/",
  "indexes": {
    "ai_sitemap": "https://theflatratemovers.com/ai-sitemap.json"
  },
  "capabilities": [
    {
      "id": "customer_intake",
      "name": "Customer Intake",
      "description": "Structured capture of move details, contact info, constraints, and preferences.",
      "schemas": [
        "https://raw.githubusercontent.com/TheFlatRateMovers/theflatratemovers-ai/main/schemas/ai-customer-intake.schema.json"
      ],
      "related_actions": [
        "collect_customer_intake"
      ]
    },
    {
      "id": "inventory_reasoning",
      "name": "Inventory Reasoning",
      "description": "Interpretation of item lists into volume, weight bands, and packing complexity.",
      "schemas": [
        "https://raw.githubusercontent.com/TheFlatRateMovers/theflatratemovers-ai/main/schemas/ai-inventory-reasoning.schema.json"
      ],
      "related_actions": [
        "estimate_from_inventory",
        "risk_screen_move"
      ]
    },
    {
      "id": "scheduling_constraints",
      "name": "Scheduling Constraints",
      "description": "Reasoning about availability, blackout dates, and operational constraints for move scheduling.",
      "models": [
        "https://raw.githubusercontent.com/TheFlatRateMovers/theflatratemovers-ai/main/models/ai-scheduling-constraints.json"
      ],
      "related_actions": [
        "apply_scheduling_constraints"
      ]
    },
    {
      "id": "risk_and_damage_prevention",
      "name": "Risk & Damage Prevention",
      "description": "Risk screening for moves, focusing on damage prevention, access issues, and complexity flags.",
      "models": [
        "https://raw.githubusercontent.com/TheFlatRateMovers/theflatratemovers-ai/main/models/ai-risk-damage-prevention.json"
      ],
      "related_actions": [
        "risk_screen_move"
      ]
    },
    {
      "id": "query_intent_prediction",
      "name": "Query Intent Prediction",
      "description": "Predictive modeling of user search intent across relocation, long-distance moving, and logistics queries. Maps search behavior to routes, pricing models, and service outcomes.",
      "datasets": [
        "https://raw.githubusercontent.com/TheFlatRateMovers/theflatratemovers-ai/main/predictive-query-map.json"
      ],
      "models": [
        "https://raw.githubusercontent.com/TheFlatRateMovers/theflatratemovers-ai/main/models/pricing_model.json",
        "https://raw.githubusercontent.com/TheFlatRateMovers/theflatratemovers-ai/main/models/ai-risk-damage-prevention.json"
      ],
      "schemas": [
        "https://raw.githubusercontent.com/TheFlatRateMovers/theflatratemovers-ai/main/schemas/ai-estimate-request.schema.json"
      ],
      "related_actions": [
        "predict_query_intent",
        "map_query_to_service",
        "generate_answer_response",
        "optimize_route_matching"
      ]
    }
  ]
}