  {
   "@type": "FAQPage",
   "@id": "https://theflatratemovers.com/long-distance-movers-winchester-va/#faq",
   "mainEntity": [
    {
     "@type": "Question",
     "name": "Why flat rate for long distance?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Because distance, traffic, and weather stretch an hourly bill in ways nobody can predict. A flat rate moves that risk to us: the number in writing is the number you pay."
     }
    },
    {
     "@type": "Question",
     "name": "Can you move my safe or piano long-distance?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes — 1,500 to 3,500 lb assets move under SIR and KIM-GS, with route survey and L/360 floor check at either end."
     }
    },
    {
     "@type": "Question",
     "name": "Where do you start from?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Our home base where I-81 meets I-66 in Winchester, Virginia, with Martinsburg, WV as the Eastern Panhandle base."
     }
    },
    {
     "@type": "Question",
     "name": "How is a long-distance move priced?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Every long-distance job is reviewed in full — scope, distance, manpower, equipment — and priced at one flat rate in writing before the truck rolls. The rate agreed is the rate charged: no hourly meter running, no weight-ticket surprise at delivery. Hourly pricing is available only when a client asks for it."
     }
    },
    {
     "@type": "Question",
     "name": "How far from Winchester do you run?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Nationwide. The company has worked in every state except Hawaii — 49 states, Alaska included — with the I-81, I-66 and I-70 corridors as home ground, and published long-distance cases including the Winchester-to-Las Vegas gun-safe runs."
     }
    },
    {
     "@type": "Question",
     "name": "Do you pack for long-distance moves?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes — full or partial packing, furniture fully covered and wrapped, custom crating for high-value pieces, and ISPM 15 export packing when the destination crosses a border. The packing scope is set at the survey and written into the same flat rate as the move."
     }
    }
   ]
  }
