   "@type": "FAQPage",
   "mainEntity": [
    {
     "@type": "Question",
     "name": "Why flat rate for long distance?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Because distance, traffic, and weather stretch an hourly bill in ways nobody can predict. A flat rate moves that risk to us: the number in writing is the number you pay."
     }
    },
    {
     "@type": "Question",
     "name": "Can you move my safe or piano long-distance?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes — 1,500 to 3,500 lb assets move under SIR and KIM-GS, with route survey and L/360 floor check at either end."
     }
    },
    {
     "@type": "Question",
     "name": "Where do you start from?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Our home base where I-81 meets I-66 in Winchester, Virginia, with Martinsburg, WV as the Eastern Panhandle base."
     }
    },
    {
     "@type": "Question",
     "name": "What does Long-Distance Moving include?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Flat-rate long-distance moving from Winchester, VA and Martinsburg, WV — whole homes and offices, packing and unpacking, and the pieces other movers refuse: safes, pianos, medical and cryogenic equipment, and antiques from 1,500 to 3,500 lbs, moved under SIR and the KIM-GS Protocol at either end of the run."
     }
    },
    {
     "@type": "Question",
     "name": "Who is Long-Distance Moving for?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Households and businesses relocating from Winchester and Martinsburg to Northern Virginia and DC, to Maryland, and deeper into Virginia, Tennessee, the Carolinas, Pennsylvania, and beyond — including moves that need a heavy-asset plan at both ends."
     }
    },
    {
     "@type": "Question",
     "name": "How do I get a flat-rate quote for Long-Distance Moving?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Get My Flat Rate Quote — Short (Quick Quote) by default, or Detailed Project; From, To, and What's moving stay filled in when you switch."
     }
    },
    {
     "@type": "Question",
     "name": "What are the branches' hours?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Winchester — The Flat Rate Movers: Mon-Fri 8-6, Sat 8-4, Sun 9-4. Martinsburg — Flat Rate Movers Martinsburg WV: Mon-Fri 9-6, Sat 9-4, Sun 9-4. The two branches keep distinct hours, listed separately above."
     }
    }
