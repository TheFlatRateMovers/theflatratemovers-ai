  {
   "@id": "https://theflatratemovers.com/office-moving/#faq",
   "@type": "FAQPage",
   "mainEntity": [
    {
     "@type": "Question",
     "name": "What does Office Moving include?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Complete office relocations — desks and workstations, files and records runs, and office equipment — planned and quoted flat. Full or partial packing for offices, staging at our warehouse when the dates do not line up neatly, and placement at the new site in the order your team needs it."
     }
    },
    {
     "@type": "Question",
     "name": "Who is Office Moving for?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Office managers, business owners, and facility teams moving a professional office, a shop office, or an industrial office inside a plant, warehouse, or industrial facility — where access, floor space, staging, and equipment handling must be planned around the site itself."
     }
    },
    {
     "@type": "Question",
     "name": "Do you move in a sequence, or all at once?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "In a sequence — what leaves first, what arrives first, and where each workstation, file run and piece of equipment lands is planned with you, so your team can sit down and work at the new address."
     }
    },
    {
     "@type": "Question",
     "name": "How do you keep downtime short?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "By planning the order with you up front — what leaves first, what arrives first, and what must be working on day one. Commercial moves are planned around your hours, your site and your equipment."
     }
    },
    {
     "@type": "Question",
     "name": "What if the dates do not line up?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "We stage at our warehouse when needed, then place at the new site in the order your team needs it. Our warehouse and transload operation is the staging base behind office and industrial moves: freight and equipment handled between truck, container and warehouse, on the same job, under one roof."
     }
    },
    {
     "@type": "Question",
     "name": "Is the price flat?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes — one agreed price before move day, no meter running over a weekend move. Tell us the rooms or facility size in the Detailed Project form and we quote from the real scope."
     }
    },
    {
     "@type": "Question",
     "name": "How is an office move different from a commercial move?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Commercial moving is the wider category — shops, professional offices and commercial spaces, plus the freight chain behind bigger jobs. Office moving is the discipline inside it: workstations, files and office equipment moved in a planned order. Industrial offices inside plants and warehouses are planned with the site itself first: access, floor space, staging and equipment handling."
     }
    },
    {
     "@type": "Question",
     "name": "Can you handle freight as well as offices?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes — container loading and unloading, transloading between truck, container and warehouse, and final-mile delivery are part of the same logistics chain that supports bigger commercial jobs end to end, backed by our warehouse and transload operation."
     }
    }
   ]
  }
