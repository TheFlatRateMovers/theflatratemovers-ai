  {
   "@id": "https://theflatratemovers.com/residential-moving/#faq",
   "@type": "FAQPage",
   "mainEntity": [
    {
     "@type": "Question",
     "name": "What does a residential move with The Flat Rate Movers include, and how is it priced?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "A residential move covers houses and apartments, across town or across the region: loading, transport, unloading, furniture protection, careful placement, and disassembly and reassembly of standard furniture, planned with you up front. Packing is your choice — full, partial, or fragile-only — plus unpacking at the other end, white-glove care for antiques and high-value pieces, and custom crates when a piece needs more than padding. The price is one flat rate agreed in writing before move day — no meter running while you watch the clock — and the guarantee stands behind it: Guaranteed Flat Rate or Your Move is Free!"
     }
    },
    {
     "@type": "Question",
     "name": "Do I have to pack everything myself?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "No — full, partial, or fragile-only packing, or we load, move, and place what you packed yourself."
     }
    },
    {
     "@type": "Question",
     "name": "Is the price really flat?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes — one price agreed in writing before move day, no meter, under the guarantee: Guaranteed Flat Rate or Your Move is Free!"
     }
    },
    {
     "@type": "Question",
     "name": "What about my safe or piano?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Those are planned under SIR and KIM-GS, with route survey and floor check, as part of your home move — not as an afterthought."
     }
    }
   ]
  }
