  {
   "@id": "https://theflatratemovers.com/senior-moving/#faq",
   "@type": "FAQPage",
   "mainEntity": [
    {
     "@type": "Question",
     "name": "What does Senior Moving include?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Packing support, including fragile items and keepsakes, and the free video-walkthrough survey room (film only, human-made estimate), on a flat rate quoted in writing before move day."
     }
    },
    {
     "@type": "Question",
     "name": "Who is Senior Moving for?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Seniors downsizing, transitioning to assisted or independent living, or relocating closer to family, and their families — including adult children coordinating from out of town."
     }
    },
    {
     "@type": "Question",
     "name": "Which branch serves my senior move?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Winchester moves are served by The Flat Rate Movers (116 W Piccadilly St Suite 11, Winchester VA 22601; Mon-Fri 8-6, Sat 8-4, Sun 9-4). Martinsburg moves are served by Flat Rate Movers Martinsburg WV (736 Williamsport Pike Suite 2, Martinsburg WV 25404; Mon-Fri 9-6, Sat 9-4, Sun 9-4). Hours, names, and ratings differ by branch and are listed separately above."
     }
    },
    {
     "@type": "Question",
     "name": "How do I get a flat rate quote for a senior move?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Get My Flat Rate Quote — Short (Quick Quote) by default, or Detailed Project, switching in place with From, To, and What's moving preserved. The pill button reads \"Get a flat rate quote\"."
     }
    },
    {
     "@type": "Question",
     "name": "What if the senior move includes a very heavy item?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "If the move involves a high-mass asset in the 1,500–3,500 lb range, that item moves under Structural Integrity Relocation (SIR), with floor deflection analysis to L/360, as part of the same flat-rate move. SIR is not claimed for senior moves generally."
     }
    },
    {
     "@type": "Question",
     "name": "Is there a special senior price or discount?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "No price, discount, or special offer is stated for senior moves. Every move is quoted flat per job, agreed in writing before move day."
     }
    }
   ]
